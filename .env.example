# === Wallet ===
PRIVATE_KEY=0x
PROFILE_ADDRESS=0x
SIGNATURE_TYPE=1

# === Polymarket CLOB API (auto-derived if not set) ===
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# === Builder API (for auto-redeem) ===
AUTO_REDEEM=true
RPC_URL=https://polygon-rpc.com
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_TX_TYPE=PROXY
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# === Trading Parameters ===
BUY_AMOUNT_USD=39.60
EDGE_THRESHOLD_CENTS=5
MAX_BUYS_PER_WINDOW=7
MAX_BUYS_PER_SIDE=5
HEDGE_MAX_PRICE_CENTS=40
ENTRY_DELAY_SECONDS=30
REDEEM_DELAY_SECONDS=200
MIN_DELTA_THRESHOLD_USD=10
VOLATILITY_LOOKBACK_SECONDS=300

# === Risk Management ===
DAILY_LOSS_LIMIT_USD=500
WEEKLY_LOSS_LIMIT_USD=2000
LOSING_STREAK_PAUSE=5
MIN_WALLET_BALANCE_USD=500

# === Operation ===
DRY_RUN=true
DEBUG=false
STATE_FILE=./data/state.json
