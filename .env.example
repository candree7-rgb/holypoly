# === Wallet ===
PRIVATE_KEY=0x
PROFILE_ADDRESS=0x
SIGNATURE_TYPE=1

# === Polymarket CLOB API (auto-derived if not set) ===
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# === Builder API (for auto-redeem) ===
AUTO_REDEEM=true
RPC_URL=https://polygon-rpc.com
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_TX_TYPE=PROXY
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# === Database (Railway PostgreSQL) ===
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === Trading Parameters (%-based for compounding) ===
BUY_AMOUNT_PCT=2              # 2% of wallet balance per order
EDGE_THRESHOLD_CENTS=5        # min edge in cents to trade (below = skip)
MAX_BUYS_PER_WINDOW=7         # hard ceiling (rarely hit)
MAX_BUYS_PER_SIDE=5           # hard ceiling (rarely hit)
ENTRY_DELAY_SECONDS=120       # wait 2 min after window open before trading
REDEEM_DELAY_SECONDS=200      # delay before redeeming after settlement
MIN_DELTA_THRESHOLD_USD=10    # skip if BTC moved less than $10
VOLATILITY_LOOKBACK_SECONDS=300

# === Edge-based order scaling ===
# Number of primary orders scales with edge strength:
#   edge < 5¢  → skip window
#   edge 5-8¢  → 1 primary order
#   edge 8-12¢ → 2 primary orders
#   edge 12-15¢→ 3 primary orders
#   edge 15+¢  → 4-5 primary orders
EDGE_TIER2_CENTS=8
EDGE_TIER3_CENTS=12
EDGE_TIER4_CENTS=15

# === Entry price filters ===
MIN_ENTRY_PRICE_CENTS=40      # no primary buys below 40¢
MAX_ENTRY_PRICE_CENTS=92      # no primary buys above 92¢

# === Dynamic hedge logic ===
# purpledeer hedges only 31% of windows (low edge = hedge, high edge = no hedge)
HEDGE_EDGE_THRESHOLD=12       # no hedge above 12¢ edge
HEDGE_MAX_PRICE_CENTS=45      # only hedge if opposite side < 45¢

# === Risk Management (%-based) ===
DAILY_LOSS_LIMIT_PCT=10       # stop after losing 10% of daily starting balance
WEEKLY_LOSS_LIMIT_PCT=20      # stop after losing 20% of weekly starting balance
LOSING_STREAK_PAUSE=5         # pause after N consecutive losing windows
MIN_BALANCE_FLOOR_USD=50      # absolute minimum — never trade below this

# === Operation ===
DRY_RUN=true
DEBUG=false

# ══════════════════════════════════════════════════
# === COPYTRADE BOT (src/copytrade/index.ts) ===
# ══════════════════════════════════════════════════

# Target trader wallet (Polymarket proxy address)
# Find on their profile: https://polymarket.com/profile/ADDRESS
COPY_TARGET_ADDRESS=0x

# Polling speed (ms) — lower = faster detection, more API calls
# 200ms for maximum speed, 500ms for conservative
COPY_POLL_INTERVAL_MS=300

# Position sizing (choose one):
# Fixed amount per copy trade (set to 0 to use percentage mode)
COPY_FIXED_AMOUNT_USD=0
# Percentage of target's trade size to copy (100 = same size)
COPY_AMOUNT_PCT=100
# Absolute limits
COPY_MAX_TRADE_USD=500
COPY_MIN_TRADE_USD=1

# Slippage control
# Max cents above target's price we're willing to pay
COPY_MAX_SLIPPAGE_CENTS=3
# Skip if ask price exceeds this (cents)
COPY_MAX_PRICE_CENTS=95

# Market filter (comma-separated, empty = all markets)
# Examples: "bitcoin,btc" or "ethereum,eth" or "bitcoin,ethereum"
COPY_MARKET_FILTER=

# Only copy BUY trades (ignore SELL/close positions)
COPY_BUYS_ONLY=true
# Copy redemption trades too
COPY_REDEMPTIONS=false

# Risk limits
COPY_MAX_EXPOSURE_PCT=50        # Max % of balance in open positions
COPY_MAX_PER_WINDOW=10          # Max copy trades per market window
COPY_COOLDOWN_MS=500            # Min ms between copy trades
